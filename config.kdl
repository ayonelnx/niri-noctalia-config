/// Niri configuration
spawn-at-startup "noctalia"
//output "HDMI-A-1" {
//    mode "1360x768@60.015"
//    position x=0 y=0
//    scale 1.0
//}
//output "eDP-1" {
//    mode "1920x1080@120.002"
//    position x=1360 y=0
//    scale 1.0
//}
input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:win_space_toggle"
        }
    }
}

window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
    geometry-corner-radius 12
    clip-to-geometry true
}

debug {
    honor-xdg-activation-with-invalid-serial
}

layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

binds {
    Super+D { spawn-sh "noctalia msg panel-toggle launcher"; }
    Super+X { spawn-sh "noctalia msg panel-toggle control-center"; }
    Super+V { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Super+K { spawn-sh "noctalia msg panel-toggle session"; }
    Super+W { spawn "firefox"; }
    Super+E { spawn "dolphin"; }
    Super+I { spawn "noctalia msg settings-toggle"; }
    Super+Return { spawn "kitty"; }
    Super+S { spawn-sh "noctalia msg screenshot-region"; }
    Super+F { toggle-window-floating; }
    Super+Q { close-window; }
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    XF86AudioRaiseVolume { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86MonBrightnessUp   { spawn-sh "brightnessctl set +5%"; }
    XF86MonBrightnessDown { spawn-sh "brightnessctl set 5%-"; }
    Super+L { spawn-sh "noctalia msg session lock"; }
}

layout {
    always-center-single-column true
}
